<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fillViewport="true"
  android:background="@color/pastel_blue">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="40dp"
      android:layout_marginBottom="40dp"
      android:fontFamily="@font/inter_extrabold"
      android:gravity="center"
      android:text="REGISTRASI"
      android:textColor="@color/dark_green"
      android:textSize="24sp"
      android:textStyle="bold" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@drawable/curve_bg"
      android:orientation="vertical"
      android:padding="24dp"
      android:elevation="4dp">

      <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="Input Nama"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etNameRegister"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:fontFamily="@font/inter"
          android:inputType="textPersonName" />
      </com.google.android.material.textfield.TextInputLayout>

      <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Input Password"
        app:passwordToggleEnabled="true"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etPasswordRegister"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:fontFamily="@font/inter"
          android:inputType="textPassword" />
      </com.google.android.material.textfield.TextInputLayout>

      <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Konfirmasi Password"
        app:passwordToggleEnabled="true"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etConfirmPasswordRegister"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:fontFamily="@font/inter"
          android:inputType="textPassword" />
      </com.google.android.material.textfield.TextInputLayout>

      <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Input No. Telephone"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <TextView
          android:id="@+id/textView2"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:fontFamily="@font/inter"
          android:text="Role" />

        <Spinner
          android:id="@+id/spnKendaraan"
          android:layout_width="match_parent"
          android:layout_height="48dp" />
      </com.google.android.material.textfield.TextInputLayout>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btnKirim"
          android:layout_width="0dp"
          android:layout_height="52dp"
          android:layout_weight="1"
          android:backgroundTint="@color/dark_green"
          android:fontFamily="@font/inter_semibold"
          android:text="Kirim"
          android:textAllCaps="false"
          android:textColor="@color/white"
          app:cornerRadius="16dp" />

        <Space
          android:layout_width="12dp"
          android:layout_height="match_parent" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btnKembali"
          android:layout_width="0dp"
          android:layout_height="52dp"
          android:layout_weight="1"
          android:backgroundTint="@color/powder_blue"
          android:text="Batal"
          android:textColor="@color/dark_green"
          android:fontFamily="@font/inter_semibold"
          app:cornerRadius="16dp"
          app:strokeColor="@color/dark_green"
          app:strokeWidth="2dp" />

      </LinearLayout>

    </LinearLayout>
  </LinearLayout>
</ScrollView>