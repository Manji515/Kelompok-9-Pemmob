<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fillViewport="true"
  android:background="@color/pastel_blue">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="40dp"
      android:layout_marginBottom="40dp"
      android:fontFamily="@font/inter_extrabold"
      android:gravity="center"
      android:text="Menu Karyawan"
      android:textColor="@color/dark_green"
      android:textSize="24sp"
      android:textStyle="bold" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@drawable/curve_bg"
      android:elevation="4dp"
      android:orientation="vertical"
      android:padding="24dp">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btnGoRegister"
          android:layout_width="0dp"
          android:layout_height="108dp"
          android:layout_weight="1"
          android:backgroundTint="@color/dark_green"
          android:fontFamily="@font/inter_semibold"
          android:text="Pengajuan Perjalanan Dinas"
          android:textAllCaps="false"
          android:textColor="@color/white"
          app:cornerRadius="16dp" />

        <Space
          android:layout_width="10dp"
          android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btnLogin"
          android:layout_width="0dp"
          android:layout_height="108dp"
          android:layout_weight="1"
          android:backgroundTint="@color/dark_green"
          android:fontFamily="@font/inter_semibold"
          android:text="Penomeran Dokumen"
          android:textAllCaps="false"
          android:textColor="@color/white"
          app:cornerRadius="16dp" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btnTombol3"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1"
          android:backgroundTint="@color/dark_green"
          android:fontFamily="@font/inter_semibold"
          android:text="Logistik Barang"
          android:textAllCaps="false"
          android:textColor="@color/white"
          app:cornerRadius="16dp" />

        <Space
          android:layout_width="12dp"
          android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btnTombol4"
          android:layout_width="0dp"
          android:layout_height="108dp"
          android:layout_weight="1"
          android:backgroundTint="@color/dark_green"
          android:fontFamily="@font/inter_semibold"
          android:text="Pengajuan Kendaraan Dinas"
          android:textAllCaps="false"
          android:textColor="@color/white"
          app:cornerRadius="16dp" />

      </LinearLayout>

    </LinearLayout>
  </LinearLayout>
</ScrollView>