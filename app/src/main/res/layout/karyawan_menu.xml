<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@color/pastel_blue">

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="40dp"
    android:layout_marginBottom="40dp"
    android:fontFamily="@font/inter_extrabold"
    android:gravity="center"
    android:text="Menu Karyawan"
    android:textColor="@color/dark_green"
    android:textSize="24sp"
    android:textStyle="bold" />

  <!-- Card putih melengkung, pakai weight=1 agar isi sisa layar -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:background="@drawable/curve_bg"
    android:elevation="4dp"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Baris tombol 1 -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="36dp"
      android:layout_marginBottom="8dp"
      android:orientation="horizontal">

      <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPengajuanPerjalananDinas"
        android:layout_width="0dp"
        android:layout_height="108dp"
        android:layout_weight="1"
        android:backgroundTint="@color/dark_green"
        android:fontFamily="@font/inter_semibold"
        android:text="Pengajuan Perjalanan Dinas"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:cornerRadius="16dp" />

      <Space android:layout_width="10dp" android:layout_height="wrap_content" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPenomeranDokumen"
        android:layout_width="0dp"
        android:layout_height="108dp"
        android:layout_weight="1"
        android:backgroundTint="@color/dark_green"
        android:fontFamily="@font/inter_semibold"
        android:text="Penomeran Dokumen"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:cornerRadius="16dp" />
    </LinearLayout>

    <!-- Baris tombol 2 -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="24dp"
      android:orientation="horizontal">

      <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogistikBarang"
        android:layout_width="0dp"
        android:layout_height="108dp"
        android:layout_weight="1"
        android:backgroundTint="@color/dark_green"
        android:fontFamily="@font/inter_semibold"
        android:text="Logistik Barang"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:cornerRadius="16dp" />

      <Space
        android:layout_width="12dp"
        android:layout_height="0dp" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPengajuanKendaraanDinas"
        android:layout_width="0dp"
        android:layout_height="108dp"
        android:layout_weight="1"
        android:backgroundTint="@color/dark_green"
        android:fontFamily="@font/inter_semibold"
        android:text="Pengajuan Kendaraan Dinas"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:cornerRadius="16dp" />
    </LinearLayout>

    <!-- Label daftar — tetap di atas, tidak ikut scroll -->
    <TextView
      android:id="@+id/textView"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:fontFamily="@font/inter_extrabold"
      android:text="Daftar Pengajuan" />

    <!-- Pesan kosong -->
    <TextView
      android:id="@+id/tvKosong"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:fontFamily="@font/inter"
      android:gravity="center"
      android:text="Belum ada pengajuan"
      android:textColor="#AAAAAA"
      android:textSize="13sp"
      android:visibility="visible" />

    <!-- RecyclerView: weight=1 → isi sisa ruang, scroll sendiri -->
    <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/rvDaftarPengajuan"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:layout_marginTop="8dp"
      android:clipToPadding="false"
      android:paddingBottom="16dp"
      android:visibility="gone" />

  </LinearLayout>
</LinearLayout>