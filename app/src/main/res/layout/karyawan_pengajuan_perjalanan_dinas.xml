<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fillViewport="true"
  android:background="@color/pastel_blue">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    >

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="40dp"
      android:layout_marginBottom="40dp"
      android:fontFamily="@font/inter_extrabold"
      android:gravity="center"
      android:text="Pengajuan Perjalanan Dinas"
      android:textColor="@color/dark_green"
      android:textSize="24sp"
      android:textStyle="bold" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@drawable/curve_bg"
      android:orientation="vertical"
      android:padding="24dp"
      android:elevation="4dp">

      <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="Tujuan Dinas">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etNamaForm"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:alpha="140"
          android:fontFamily="@font/inter" />
      </com.google.android.material.textfield.TextInputLayout>

      <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Biaya Perjalanan">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etEmailForm"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:alpha="140"
          android:fontFamily="@font/inter" />
      </com.google.android.material.textfield.TextInputLayout>

      <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="12dp"
        android:hint="Alasan">
        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etPhoneForm"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:alpha="140"
          android:fontFamily="@font/inter" />
      </com.google.android.material.textfield.TextInputLayout>

      <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitRegistration"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/dark_green"
        android:fontFamily="@font/inter_semibold"
        android:text="Kirim"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:cornerRadius="16dp" />
    </LinearLayout>
  </LinearLayout>
</ScrollView>